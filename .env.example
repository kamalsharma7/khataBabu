# --- Application ---
APP_NAME=KhataBabu API
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
LOG_REQUEST_ID_HEADER=X-Request-ID

# --- PostgreSQL (use DATABASE_URL OR individual fields) ---
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=khatababu
POSTGRES_PASSWORD=khatababu
POSTGRES_DB=khatababu
POSTGRES_SSL_MODE=prefer
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Redis (optional) ---
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# --- Kafka (optional) ---
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=khatababu-api
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# --- Platform super-admin (internal onboarding console) ---
PLATFORM_JWT_SECRET=replace-with-64-char-random-secret-in-production-minimum-32
PLATFORM_JWT_AUDIENCE=khatababu-platform
PLATFORM_ACCESS_TOKEN_EXPIRE_MINUTES=60
# --- Owner app JWT (24h default) ---
OWNER_JWT_SECRET=replace-with-separate-owner-jwt-secret-min-32-chars
OWNER_JWT_AUDIENCE=khatababu-owner
OWNER_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Reserved for future mobile OTP step after password login:
# PLATFORM_OTP_PEPPER=replace-with-random-otp-pepper-min-16-chars
# PLATFORM_EXPOSE_OTP_IN_RESPONSE=false
